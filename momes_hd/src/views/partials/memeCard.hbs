    <img src="{{post.image_url}}" class="card-img-top img-fluid" alt="...">
    <div class="card-body">
        <p class="card-text">{{post.description}}</p>
        <p class="card-text"><small class="text-body-secondary" title="La fecha">{{relativeTime post.createdAt}}</small></p>
    </div>
</div>